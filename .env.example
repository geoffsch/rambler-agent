# Copy to .env (git-ignored). All variables optional until the phase that needs them.

# Anthropic API key -- needed from Phase 3 (agent). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# TransportAPI free tier (30 requests/day) -- needed from Phase 2. https://www.transportapi.com/
TRANSPORTAPI_APP_ID=
TRANSPORTAPI_APP_KEY=

# Contact e-mail placed in the HTTP User-Agent so site operators can reach you.
# Strongly recommended before running any ingestion (SWC / Overpass etiquette).
RAMBLER_CONTACT=

# Where ingested data, the walk DB and the HTTP cache live. Default: ./data
# RAMBLER_DATA_DIR=data

# Path to your personal profile. Default: ./user_profile.yaml
# RAMBLER_PROFILE_PATH=user_profile.yaml
